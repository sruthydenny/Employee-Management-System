@model IEnumerable<EmployeeManagementSystem.Models.CompanyEvent>

@{
    ViewData["Title"] = "Company Events";
}

<div class="container mt-4">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Company Events
            </h2>

            <p class="text-muted mb-0">
                Manage upcoming and past company events.
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            + Create Event

        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Events -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm events-card">

            <div class="card-body p-0">

                <div class="table-responsive events-table-wrapper">

                    <table class="table table-hover align-middle mb-0 events-table">

                        <thead>

                            <tr>

                                <th>
                                    Event
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Location
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Event -->

                                    <td>

                                        <strong>
                                            @item.Title
                                        </strong>

                                    </td>


                                    <!-- Description -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            if (item.Description.Length > 80)
                                            {
                                                @item.Description.Substring(0, 80)

                                                <span>
                                                    ...
                                                </span>
                                            }
                                            else
                                            {
                                                @item.Description
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }

                                    </td>


                                    <!-- Date -->

                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy, HH:mm")
                                    </td>


                                    <!-- Location -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Location))
                                        {
                                            @item.Location
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end event-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Empty State -->

        <div class="card shadow-sm events-card">

            <div class="card-body text-center py-5">

                <h5 class="fw-bold">
                    No company events yet
                </h5>

                <p class="text-muted">
                    Create your first company event to display it here.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    Create Event

                </a>

            </div>

        </div>
    }

</div>