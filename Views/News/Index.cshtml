@model IEnumerable<EmployeeManagementSystem.Models.News>

@{
    ViewData["Title"] = "Company News";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Company News
            </h2>

            <p class="text-muted mb-0">
                Manage company announcements and important news.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add News
        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0 news-table">

                        <thead>
                            <tr>

                                <th class="px-4">
                                    Title
                                </th>

                                <th>
                                    Published
                                </th>

                                <th>
                                    Importance
                                </th>

                                <th class="text-end px-4">
                                    Actions
                                </th>

                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Title -->
                                    <td class="px-4">

                                        <div class="fw-semibold">
                                            @item.Title
                                        </div>

                                        <div class="small text-muted news-preview">
                                            @(item.Content.Length > 100
                                                ? item.Content.Substring(0, 100) + "..."
                                                : item.Content)
                                        </div>

                                    </td>


                                    <!-- Date -->
                                    <td>

                                        <span class="text-muted">
                                            @item.PublishedDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <!-- Importance -->
                                    <td>

                                        @if (item.IsImportant)
                                        {
                                            <span class="badge bg-danger">
                                                Important
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Normal
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="px-4 news-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <h5 class="fw-bold">
                    No company news yet
                </h5>

                <p class="text-muted">
                    Create your first company announcement.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add News
                </a>

            </div>

        </div>
    }

</div>


<style>

    .news-preview {
        max-width: 500px;
        margin-top: 4px;
    }

    /* Dark mode */
    body.dark-mode .news-table,
    body.dark-mode .news-table tbody,
    body.dark-mode .news-table tr,
    body.dark-mode .news-table td {
        background: var(--surface);
        color: var(--text-primary);
        border-color: var(--border);
    }

    body.dark-mode .news-table thead,
    body.dark-mode .news-table thead tr,
    body.dark-mode .news-table thead th {
        background: #1e293b;
        color: #cbd5e1;
        border-color: var(--border);
    }

    body.dark-mode .news-table .text-muted {
        color: var(--text-secondary) !important;
    }

</style>