@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="delete-employee-page">

    <!-- Page Header -->
    <div class="delete-header">

        <div>
            <span class="eyebrow">EMPLOYEE OPERATIONS</span>

            <h1>Delete Employee</h1>

            <p>
                Review the employee information before permanently removing this record.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Back to Employees
        </a>

    </div>


    <!-- Delete Card -->
    <div class="delete-card">

        <!-- Warning Header -->
        <div class="delete-card-header">

            <div class="delete-icon">
                !
            </div>

            <div>
                <h2>Delete Employee Record</h2>

                <p>
                    This action cannot be undone.
                </p>
            </div>

        </div>


        <!-- Warning Message -->
        <div class="delete-warning">

            <strong>Are you sure you want to delete this employee?</strong>

            <span>
                The employee record and its information will be permanently removed
                from the system.
            </span>

        </div>


        <!-- Employee Information -->
        <div class="delete-information">

            <span class="section-title">
                EMPLOYEE INFORMATION
            </span>


            <div class="employee-summary">

                <div class="employee-avatar">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>

                <div>

                    <h3>
                        @Model.FullName
                    </h3>

                    <p>
                        @Model.Position
                    </p>

                </div>

            </div>


            <div class="delete-details">

                <div class="delete-detail">

                    <span>EMAIL ADDRESS</span>

                    <strong>
                        @Model.Email
                    </strong>

                </div>


                <div class="delete-detail">

                    <span>DEPARTMENT</span>

                    <strong>
                        @Model.Department
                    </strong>

                </div>


                <div class="delete-detail">

                    <span>SALARY</span>

                    <strong>
                        €@Model.Salary.ToString("N2")
                    </strong>

                </div>


                <div class="delete-detail">

                    <span>HIRE DATE</span>

                    <strong>
                        @Model.HireDate.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="delete-actions">

            <a asp-action="Index"
               class="cancel-delete-button">
                Cancel
            </a>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="confirm-delete-button">
                    Delete Employee
                </button>

            </form>

        </div>

    </div>

</div>