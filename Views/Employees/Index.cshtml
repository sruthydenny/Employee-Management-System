@model IEnumerable<EmployeeManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="employees-page">

    <!-- Page Header -->
    <div class="employees-header">

        <div>
            <span class="eyebrow">EMPLOYEE OPERATIONS</span>

            <h1>Employee</h1>

            <p>
                Manage employee records, departments and workforce information.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="employee-add-button">
                Add Employee
            </a>
        }

    </div>


    <!-- Employee Management Panel -->
    <div class="employee-panel">

        <!-- Panel Header -->
        <div class="employee-panel-header">

            <div>
                <span class="panel-eyebrow">WORKFORCE DIRECTORY</span>

                <h2>Employee Records</h2>
            </div>

            <div class="employee-count">
                @Model.Count() employees
            </div>

        </div>


        <!-- Search & Filters -->
        @if (User.IsInRole("Admin"))
        {
            <div class="employee-filters">

                <form asp-action="Index"
                      method="get"
                      class="filter-form">

                    <div class="search-wrapper">

                        <span class="search-icon">⌕</span>

                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="employee-search"
                               placeholder="Search by employee name or email..." />

                    </div>


                    <div class="department-wrapper">

                        <select name="department"
                                class="employee-select">

                            <option value="">All Departments</option>

                            @foreach (var dept in ViewBag.Departments)
                            {
                                if (dept == (string?)ViewData["CurrentDepartment"])
                                {
                                    <option value="@dept" selected>
                                        @dept
                                    </option>
                                }
                                else
                                {
                                    <option value="@dept">
                                        @dept
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <button type="submit"
                            class="filter-button">
                        Search
                    </button>


                    <a asp-action="Index"
                       class="clear-button">
                        Clear
                    </a>

                </form>

            </div>
        }


        <!-- Employee Table -->
        <div class="employee-table-wrapper">

            <table class="employee-table">

                <thead>

                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Salary</th>
                        <th>Hire Date</th>
                        <th class="actions-column">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Employee -->
                                <td>

                                    <div class="employee-info">

                                        <div class="employee-avatar">
                                            @(string.IsNullOrEmpty(item.FullName)
                                                ? "?"
                                                : item.FullName.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>
                                            <strong>
                                                @item.FullName
                                            </strong>

                                            <span>
                                                @item.Email
                                            </span>
                                        </div>

                                    </div>

                                </td>


                                <!-- Department -->
                                <td>

                                    <span class="department-badge">
                                        @item.Department
                                    </span>

                                </td>


                                <!-- Position -->
                                <td>

                                    <span class="position-text">
                                        @item.Position
                                    </span>

                                </td>


                                <!-- Salary -->
                                <td>

                                    <span class="salary-text">
                                        €@item.Salary.ToString("N2")
                                    </span>

                                </td>


                                <!-- Hire Date -->
                                <td>

                                    <span class="hire-date">
                                        @item.HireDate.ToString("dd MMM yyyy")
                                    </span>

                                </td>


                                <!-- Actions -->
                                <td class="actions-column">

                                    <div class="employee-actions">

                                        <!-- Everyone can view their permitted employee -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="table-action view-action"
                                           title="View employee">
                                            View
                                        </a>


                                        <!-- Admin only -->
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="table-action edit-action"
                                               title="Edit employee">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="table-action delete-action"
                                               title="Delete employee">
                                                Delete
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6">

                                <div class="empty-state">

                                    <div class="empty-icon">
                                        👥
                                    </div>

                                    <h3>No employees found</h3>


                                    @if (User.IsInRole("Admin"))
                                    {
                                        <p>
                                            Try changing your search or department filter.
                                        </p>

                                        <a asp-action="Create"
                                           class="employee-add-button">
                                            <span>+</span>
                                            Add Employee
                                        </a>
                                    }
                                    else
                                    {
                                        <p>
                                            No employee profile is currently assigned to your account.
                                        </p>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>