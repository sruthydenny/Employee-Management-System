@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<div class="create-employee-page">

    <!-- Page Header -->
    <div class="create-header">

        <div>
            <span class="eyebrow">EMPLOYEE OPERATIONS</span>

            <h1>Add Employee</h1>

            <p>
                Create a new employee record and add it to the workforce directory.
            </p>
        </div>

        <a asp-action="Index" class="back-button">
            ← Back to Employees
        </a>

    </div>


    <!-- Form Card -->
    <div class="create-card">

        <div class="create-card-header">

            <div class="create-icon">
                +
            </div>

            <div>
                <h2>Employee Information</h2>

                <p>
                    Enter the employee's details below.
                </p>
            </div>

        </div>


        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <div class="form-section">

                <div class="section-title">
                    Personal Information
                </div>


                <div class="form-row">

                    <div class="form-field">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="modern-input"
                               placeholder="e.g. John Smith"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="field-error">
                        </span>

                    </div>


                    <div class="form-field">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="modern-input"
                               type="email"
                               placeholder="e.g. john.smith@company.com"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-section">

                <div class="section-title">
                    Employment Information
                </div>


                <div class="form-row">

                    <div class="form-field">

                        <label asp-for="Department">
                            Department
                        </label>

                        <input asp-for="Department"
                               class="modern-input"
                               placeholder="e.g. Technology" />

                        <span asp-validation-for="Department"
                              class="field-error">
                        </span>

                    </div>


                    <div class="form-field">

                        <label asp-for="Position">
                            Job Position
                        </label>

                        <input asp-for="Position"
                               class="modern-input"
                               placeholder="e.g. Software Developer" />

                        <span asp-validation-for="Position"
                              class="field-error">
                        </span>

                    </div>

                </div>


                <div class="form-row">

                    <div class="form-field">

                        <label asp-for="Salary">
                            Annual Salary
                        </label>

                        <div class="input-prefix">

                            <span>€</span>

                            <input asp-for="Salary"
                                   class="modern-input salary-input"
                                   type="number"
                                   min="1"
                                   step="0.01"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="Salary"
                              class="field-error">
                        </span>

                    </div>


                    <div class="form-field">

                        <label asp-for="HireDate">
                            Hire Date
                        </label>

                        <input asp-for="HireDate"
                               class="modern-input"
                               type="date" />

                        <span asp-validation-for="HireDate"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Form Actions -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="save-button">
                    <span>✓</span>
                    Create Employee
                </button>

            </div>

        </form>

    </div>


    <!-- Validation Notice -->

    <div class="form-notice">

        <span>ⓘ</span>

        <div>
            <strong>Data quality matters</strong>

            <p>
                Please ensure employee information is accurate before saving.
                Required fields and validation rules are applied automatically.
            </p>
        </div>

    </div>

</div>