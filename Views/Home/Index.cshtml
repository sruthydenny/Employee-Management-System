@model EmployeeManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">👨‍💼 Employee Management Dashboard</h1>
        <p class="text-muted">Manage employees and monitor company statistics.</p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <h5>Total Employees</h5>
                    <h2>@Model.TotalEmployees</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 bg-success text-white">
                <div class="card-body text-center">
                    <h5>Departments</h5>
                    <h2>@Model.TotalDepartments</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 bg-warning text-dark">
                <div class="card-body text-center">
                    <h5>Average Salary</h5>
                    <h2>@Model.AverageSalary.ToString("C")</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow mt-4">
        <div class="card-header bg-dark text-white">
            Quick Actions
        </div>

        <div class="card-body">

            <a asp-controller="Employees"
               asp-action="Index"
               class="btn btn-primary me-2">
                View Employees
            </a>

            <a asp-controller="Employees"
               asp-action="Create"
               class="btn btn-success">
                Add Employee
            </a>

        </div>

    </div>

</div>