@model EmployeeManagementSystem.Models.EmployeePerformance

@{
    ViewData["Title"] = "Edit Performance";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Edit Performance</h2>

            <p class="text-muted mb-0">
                Update an employee's performance record.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Performance
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- Employee -->

                <div class="mb-3">

                    <label asp-for="EmployeeId"
                           class="form-label fw-semibold">
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="form-select">

                        <option value="">
                            -- Select Employee --
                        </option>

                        @if (ViewBag.Employees != null)
                        {
                            foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.Id">
                                    @employee.FullName
                                    - @employee.Department
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Month -->

                <div class="mb-3">

                    <label asp-for="Month"
                           class="form-label fw-semibold">
                        Month
                    </label>

                    <input asp-for="Month"
                           class="form-control"
                           placeholder="e.g. September 2026" />

                    <span asp-validation-for="Month"
                          class="text-danger">
                    </span>

                </div>


                <!-- Score -->

                <div class="mb-3">

                    <label asp-for="Score"
                           class="form-label fw-semibold">
                        Performance Score
                    </label>

                    <input asp-for="Score"
                           type="number"
                           min="0"
                           max="100"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter score from 0 to 100" />

                    <div class="form-text">
                        Enter a score between 0 and 100.
                    </div>

                    <span asp-validation-for="Score"
                          class="text-danger">
                    </span>

                </div>


                <!-- Comments -->

                <div class="mb-4">

                    <label asp-for="Comments"
                           class="form-label fw-semibold">
                        Comments
                    </label>

                    <textarea asp-for="Comments"
                              class="form-control"
                              rows="4"
                              placeholder="Enter performance comments"></textarea>

                    <span asp-validation-for="Comments"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}