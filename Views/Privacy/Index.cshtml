@{
    ViewData["Title"] = "Privacy & Data Protection";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Privacy & Data Protection
        </h2>

        <p class="text-muted mb-0">
            Learn how WorkSphere handles information within the employee management system.
        </p>

    </div>


    <!-- Introduction -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Your Privacy Matters
            </h5>

            <p class="text-muted mb-0">
                WorkSphere is designed to help organizations manage employee
                information, tasks, attendance, performance, company news,
                and events in one centralized system.
            </p>

        </div>

    </div>


    <div class="row g-4">

        <!-- Information We Collect -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Information We Collect
                    </h5>

                    <p class="text-muted">
                        Depending on your role and use of WorkSphere, the
                        system may store information such as:
                    </p>

                    <ul class="text-muted mb-0">
                        <li>Employee profile information</li>
                        <li>Account and login information</li>
                        <li>Attendance records</li>
                        <li>Performance information</li>
                        <li>Task information</li>
                        <li>Company news and event information</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- How Information Is Used -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        How Information Is Used
                    </h5>

                    <p class="text-muted">
                        Information stored in WorkSphere is used to support
                        employee management and day-to-day organizational
                        operations.
                    </p>

                    <ul class="text-muted mb-0">
                        <li>Managing employee records</li>
                        <li>Tracking attendance</li>
                        <li>Managing employee performance</li>
                        <li>Assigning and tracking tasks</li>
                        <li>Sharing company announcements</li>
                        <li>Managing company events</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- Access & Security -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Access & Security
                    </h5>

                    <p class="text-muted mb-3">
                        WorkSphere uses authentication and role-based
                        authorization to control access to application
                        features.
                    </p>

                    <ul class="text-muted mb-0">
                        <li>Users must sign in to access the application.</li>
                        <li>Administrative features are restricted to administrators.</li>
                        <li>Users can access information intended for their account.</li>
                        <li>Authentication is handled through ASP.NET Core Identity.</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- Attendance & Performance -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Attendance & Performance Data
                    </h5>

                    <p class="text-muted mb-0">
                        Attendance and performance information is part of
                        the employee management system and should only be
                        accessed or managed by authorized personnel.
                        Users should not share confidential employee
                        information with unauthorized individuals.
                    </p>

                </div>

            </div>

        </div>


        <!-- AI Assistant -->
        <div class="col-12">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        🤖 WorkSphere AI Assistant
                    </h5>

                    <p class="text-muted">
                        WorkSphere includes an AI Assistant designed to help
                        users understand and navigate the application.
                    </p>

                    <div class="alert alert-warning mb-0">

                        <strong>Important:</strong>

                        Do not enter passwords, confidential employee
                        information, financial information, or other
                        sensitive data into the AI Assistant.
                    </div>

                    <p class="text-muted mt-3 mb-0">
                        The current WorkSphere implementation uses a locally
                        running AI service for the assistant. The assistant
                        should be used primarily for questions about
                        WorkSphere features and navigation.
                    </p>

                </div>

            </div>

        </div>


        <!-- User Responsibilities -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Your Responsibilities
                    </h5>

                    <ul class="text-muted mb-0">
                        <li>Keep your login credentials secure.</li>
                        <li>Do not share your account with other people.</li>
                        <li>Do not enter sensitive information into the AI Assistant.</li>
                        <li>Report suspicious or unauthorized access to the administrator.</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- Questions -->
        <div class="col-12 col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Questions About Privacy
                    </h5>

                    <p class="text-muted mb-0">
                        If you have questions about how information is
                        handled within your WorkSphere installation,
                        please contact the system administrator.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Last Updated -->
    <div class="text-muted small mt-4 mb-4">
        WorkSphere Privacy Information
    </div>

</div>